.DS_Store
.history/
node_modules/
output/
portfolio_review_*/

# Local portfolio backup and review notes
/assets/_portfolio.pdf
/docs/portfolio-1017-review.md
/docs/portfolio-1017-final-proofread.md

# Local original images and unused backup assets
/.local/
# Raw design sources and screen recordings (only optimized images go to src/assets)
/local/

# Local Python environment for font subsetting
/.venv-fonts/
__pycache__/

# Generated build and deployment output
/dist/
/.build/

# Local credentials and signing keys
.env
.env.*
!.env.example
!.env.sample
/secrets/
*.pem
*.key
*.p12
*.pfx

# Editor settings
/.vscode/

# Example app: Vite compiles .scss directly, so editor-compiled CSS is local only
/examples/*/src/**/*.css
/examples/*/src/**/*.css.map
/examples/*/node_modules/
/examples/*/dist/

# Local logs, OS files and personal tool settings
*.log
npm-debug.log*
Thumbs.db
/.claude/settings.local.json

# Local design-tool context (impeccable) and internal positioning notes
/.impeccable/
/PRODUCT.md
/DESIGN.md
